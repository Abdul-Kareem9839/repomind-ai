# ==========================
# Server Configuration
# ==========================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================
# MongoDB
# ==========================
MONGO_URI=mongodb://127.0.0.1:27017/repomind-ai

# ==========================
# JWT / Auth (access-token only for V1)
# ==========================
JWT_SECRET=change_this_access_token_secret
JWT_EXPIRES_IN=7d

# ==========================
# Google Gemini API
# ==========================
# Use Google's new API key format (starts with "AQ.") e.g. AQ.YOUR_KEY_HERE
# Required for chat generation only. Embeddings use a local open-source model.
GEMINI_API_KEY=AQ.YOUR_KEY_HERE
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# ==========================
# Local Embeddings
# ==========================
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
LOCAL_EMBEDDING_CACHE_DIR=.cache/xenova
LOCAL_EMBEDDING_LOCAL_MODEL_PATH=
LOCAL_EMBEDDING_ALLOW_REMOTE_MODELS=true
LOCAL_EMBEDDING_BATCH_SIZE=64
EMBEDDING_COLLECTION_VERSION=v1

# ==========================
# ChromaDB
# ==========================
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_PREFIX=repomind

# ==========================
# Uploads / Storage
# ==========================
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads
TEMP_DIR=temp
CHAT_HISTORY_DIR=chat-history

# ==========================
# Rate Limiting
# ==========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
